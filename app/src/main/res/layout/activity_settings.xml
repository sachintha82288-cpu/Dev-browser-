<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gx_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="General" android:textColor="@color/gx_accent"
            android:textStyle="bold" android:paddingBottom="6dp" />

        <EditText android:id="@+id/homePage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Home page"
            android:importantForAutofill="no" android:inputType="textUri" />
        <EditText android:id="@+id/searchEngine" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Search URL (use %s)"
            android:importantForAutofill="no" android:inputType="textUri" />
        <EditText android:id="@+id/userAgent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Custom user agent (optional)"
            android:importantForAutofill="no" android:inputType="text" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="14dp" android:background="@color/gx_stroke" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Developer" android:textColor="@color/gx_accent"
            android:textStyle="bold" android:paddingBottom="6dp" />

        <CheckBox android:id="@+id/cbJs" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Enable JavaScript" />
        <CheckBox android:id="@+id/cbRemote" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remote debugging (about:debugging over adb)" />
        <CheckBox android:id="@+id/cbDesktop" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Request desktop site" />
        <CheckBox android:id="@+id/cbTp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Enhanced tracking protection" />

        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/save" android:background="@drawable/bg_accent_button"
            android:textColor="@color/gx_text" />

        <Button android:id="@+id/btnAboutConfig" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Open about:config" android:background="@drawable/bg_tool_button"
            android:textColor="@color/gx_text" />
    </LinearLayout>
</ScrollView>
