<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gx_bg"
    android:fitsSystemWindows="true">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabStrip"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnNewTab" />

    <ImageButton
        android:id="@+id/btnNewTab"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_tool_button"
        android:contentDescription="@string/new_tab"
        android:padding="8dp"
        android:src="@drawable/ic_add"
        app:layout_constraintTop_toTopOf="@id/tabStrip"
        app:layout_constraintBottom_toBottomOf="@id/tabStrip"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/urlBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_urlbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/tabStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/securityIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            app:tint="@color/gx_green" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_or_url"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="@color/gx_text"
            android:textColorHint="@color/gx_text_dim"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/proxyBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/proxy_and_tor"
            android:src="@drawable/ic_shield"
            app:tint="@color/gx_text_dim" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reload"
            android:src="@drawable/ic_reload"
            app:tint="@color/gx_text_dim" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_gx"
        app:layout_constraintTop_toBottomOf="@id/urlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/gx_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/btnBack" style="@style/GxToolButton"
            android:layout_weight="1" android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/btnForward" style="@style/GxToolButton"
            android:layout_weight="1" android:contentDescription="@string/forward"
            android:src="@drawable/ic_forward" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/btnDevTools" style="@style/GxToolButton"
            android:layout_weight="1" android:contentDescription="@string/dev_tools"
            android:src="@drawable/ic_code" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/btnTabs" style="@style/GxToolButton"
            android:layout_weight="1" android:contentDescription="@string/tabs"
            android:src="@drawable/ic_tabs" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/btnMenu" style="@style/GxToolButton"
            android:layout_weight="1" android:contentDescription="@string/menu"
            android:src="@drawable/ic_menu" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
